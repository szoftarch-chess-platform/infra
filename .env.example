# Variables of the compose files.

# The compose files that every docker compose command loads.
# For a service on the host add its override file, as the README describes.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.dev.yaml

# Image tags of the services. A service built from its sibling folder uses the tag dev.
FRONTEND_TAG=dev
GAME_SERVICE_TAG=dev
ENGINE_SERVICE_TAG=dev
PLATFORM_SERVICE_TAG=dev

# Host port of the gateway.
GATEWAY_PORT=8443

# Password of the PostgreSQL superuser postgres.
POSTGRES_ADMIN_PASSWORD=

# Password of the PostgreSQL user platform of the platform-service.
POSTGRES_PLATFORM_PASSWORD=

# Password of the Redis user game-service.
REDIS_GAME_PASSWORD=

# Password of the RabbitMQ user admin.
RABBITMQ_ADMIN_PASSWORD=

# Password of the RabbitMQ user game-service.
RABBITMQ_GAME_PASSWORD=

# Password of the RabbitMQ user platform-service.
RABBITMQ_PLATFORM_PASSWORD=
